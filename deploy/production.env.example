# Production secrets. Copy to deploy/production.env — gitignored, and it must
# stay out of the repository. Better still, skip the file entirely and use a
# systemd EnvironmentFile outside the checkout, or your host's secret store.
#
# The API refuses to start if any of the following is true (app/config.py):
#   - JWT_SECRET is a placeholder or shorter than 32 characters
#   - DATABASE_URL is SQLite
#   - ENABLE_DOCS is true
#   - CORS_ORIGINS is empty
#
# Generate a secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── required ───────────────────────────────────────────────────────────
JWT_SECRET=
POSTGRES_PASSWORD=
# The scheme and host the browser actually uses. Becomes CORS_ORIGINS; the
# development LAN regex is ignored in production.
PUBLIC_ORIGIN=https://forgefit.example.com

# ── third-party ────────────────────────────────────────────────────────
OPENAI_API_KEY=
NUTRITION_APP_ID=
NUTRITION_APP_KEY=
NUTRITION_API_BASE_URL=https://app.100daysofpython.dev/services/nutrition/v2

# ── optional ───────────────────────────────────────────────────────────
SENTRY_DSN=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=20160
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_NLP=20/minute
MAX_NLP_CHARS=500

# Set REFRESH_COOKIE_SAMESITE=none only if the API and the frontend are on
# different sites; that also requires HTTPS and widens CSRF exposure.
REFRESH_COOKIE_SAMESITE=lax

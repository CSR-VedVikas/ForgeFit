backend/.venv/
# Any SQLite file anywhere: they carry user rows and password hashes.
*.db
*.db.bak-*
backend/*.db
backend/*.db.bak-*
backend/.env
backend/.env.local
frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
.DS_Store
.env
**/.env
**/.env.*
!**/.env.example

# Production secrets never enter the repository. deploy/production.env is
# created from deploy/production.env.example on the host.
deploy/production.env
deploy/certs/
deploy/certbot/
*.pem
*.key

# Design-project working residue: PDF page rasters and pasted screenshots.
# The prototypes and the design system are tracked; these are not.
design/scraps/
design/uploads/
design/*.zip

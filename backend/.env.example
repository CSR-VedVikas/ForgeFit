# Local development template. Copy to backend/.env — which is gitignored and
# must stay that way.
#
# This file is for DEVELOPMENT ONLY. It will not start in production: the
# config validator rejects the placeholder secret, SQLite, and ENABLE_DOCS.
# For a real deploy use deploy/production.env.example instead.

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Nutrition (100 Days of Python portal — regenerate if 401)
NUTRITION_APP_ID=app_your_app_id
NUTRITION_APP_KEY=nix_live_your_key
# Must end in /v2. Pointing this at /docs sends food lookups to the
# documentation page and the Fuel screen comes back empty.
NUTRITION_API_BASE_URL=https://app.100daysofpython.dev/services/nutrition/v2

# Auth
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
# Short, because a refresh token now covers the gap. 15 minutes means a stolen
# access token is useful for 15 minutes rather than an hour.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Refresh cookie (httpOnly; never readable from JavaScript)
REFRESH_COOKIE_NAME=forgefit_refresh
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAMESITE=lax
# Secure is forced on in production and off in development — not settable.

# Paths
EXERCISES_JSON_PATH=../exercises-dataset-main/data/exercises.json
MEDIA_ROOT=../exercises-dataset-main
DATABASE_URL=sqlite:///./forgefit_clean.db

# CORS / env
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
ENABLE_DOCS=true
SENTRY_DSN=
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_NLP=20/minute
MAX_NLP_CHARS=500

# Reverse proxy. Leave false for local development — trusting
# X-Forwarded-For with nothing in front lets a client forge its own IP and
# bypass the auth rate limit.
BEHIND_PROXY=false
TRUSTED_PROXY_HOPS=1
